{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Standort & Abruf",
            "items": [
                {
                    "type": "Label",
                    "caption": "Ein einziger API-Call deckt alle 4 Flächen ab (Open-Meteo, kostenlos, kein API-Key nötig)."
                },
                {
                    "type": "NumberSpinner",
                    "name": "Latitude",
                    "caption": "Latitude",
                    "digits": 6
                },
                {
                    "type": "NumberSpinner",
                    "name": "Longitude",
                    "caption": "Longitude",
                    "digits": 6
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Timezone",
                    "caption": "Zeitzone ('auto' = automatisch anhand Latitude/Longitude)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ForecastDays",
                    "caption": "Prognosehorizont in Tagen (empfohlen 2-4)",
                    "minimum": 0,
                    "maximum": 16
                },
                {
                    "type": "NumberSpinner",
                    "name": "PastDays",
                    "caption": "Vergangene Tage mit abrufen",
                    "minimum": 0,
                    "maximum": 92
                },
                {
                    "type": "Select",
                    "name": "UpdateIntervalMinutes",
                    "caption": "Abrufintervall",
                    "options": [
                        {
                            "caption": "Manuell (Timer aus)",
                            "value": 0
                        },
                        {
                            "caption": "15 Minuten",
                            "value": 15
                        },
                        {
                            "caption": "30 Minuten",
                            "value": 30
                        },
                        {
                            "caption": "60 Minuten",
                            "value": 60
                        },
                        {
                            "caption": "120 Minuten",
                            "value": 120
                        },
                        {
                            "caption": "180 Minuten",
                            "value": 180
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "PV-Berechnung (global)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Wird auf alle aktiven Flächen angewendet. GTI-Transposition: isotropes Himmelsmodell (Liu-Jordan). Zelltemperatur: Faiman-Modell."
                },
                {
                    "type": "NumberSpinner",
                    "name": "TempCoeffPercent",
                    "caption": "Temperaturkoeffizient (%/°C, bezogen auf 25°C Zelltemperatur - negativ eingeben)",
                    "digits": 2
                },
                {
                    "type": "NumberSpinner",
                    "name": "Albedo",
                    "caption": "Bodenreflexion (Albedo, 0.0-1.0)",
                    "digits": 2,
                    "minimum": 0,
                    "maximum": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "SystemLossPercent",
                    "caption": "Systemverluste gesamt (Wechselrichter/Verkabelung/Verschmutzung, %)",
                    "digits": 1,
                    "minimum": 0,
                    "maximum": 50
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "PV-Fläche 1 (PV Hausdach)",
