{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "API Einstellungen (Forecast.Solar Public)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Public Plan ohne API Key. Rate Limit: 12 Requests/Stunde je IP-Adresse. Dieses Modul benötigt 1 Request je aktiver PV-Fläche pro Abruf."
                },
                {
                    "type": "PasswordTextBox",
                    "name": "APIKey",
                    "caption": "API Key (optional, nur für Personal/Professional Plan - leer lassen für Public)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaxRequestsPerHour",
                    "caption": "Maximale API Requests pro Stunde",
                    "minimum": 1,
                    "maximum": 1000
                },
                {
                    "type": "Select",
                    "name": "UpdateIntervalMinutes",
                    "caption": "Abrufintervall",
                    "options": [
                        {
                            "caption": "DEAKTIVIERT",
                            "value": 0
                        },
                        {
                            "caption": "Alle 15 Minuten (4 Zyklen/Stunde)",
                            "value": 15
                        },
                        {
                            "caption": "Alle 30 Minuten (2 Zyklen/Stunde) - empfohlen bei 4 Flächen",
                            "value": 30
                        },
                        {
                            "caption": "Alle 60 Minuten (1 Zyklus/Stunde)",
                            "value": 60
                        }
                    ]
                },
                {
                    "type": "Label",
                    "caption": "Hinweis: Forecast.Solar liefert im Public Plan nur einen Schätzwert je Zeitscheibe (kein P10/P90 Unsicherheitsband wie bei Solcast)."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "PV-Fläche 1",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "Site1Active",
                    "caption": "Aktiv"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Site1Name",
                    "caption": "Bezeichnung"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Site1Latitude",
                    "caption": "Latitude",
                    "digits": 6
                },
                {
                    "type": "NumberSpinner",
                    "name": "Site1Longitude",
                    "caption": "Longitude",
                    "digits": 6
                },
                {
                    "type": "NumberSpinner",
                    "name": "Site1Declination",
                    "caption": "Neigung (0=flach, 90=senkrecht)",
                    "minimum": 0,
                    "maximum": 90
                },
                {
                    "type": "NumberSpinner",
                    "name": "Site1Azimuth",
                    "caption": "Azimut (-180=Nord .. 0=Süd .. 180=Nord, -90=Ost, 90=West)",
                    "minimum": -180,
                    "maximum": 180
                },
                {
                    "type": "NumberSpinner",
                    "name": "Site1kWp",
                    "caption": "Modulleistung (kWp)",
